__pycache__/
*.pyc
.venv/
results/
*.png
*.jpg

*.out
*.err
.ipynb_checkpoints/

# Test fixtures are regenerated by tools/make_fixtures.py: downloaded portraits,
# ONNX models and stub outputs. Not redistributed from here.
tests/fixtures/out/
tests/fixtures/models/
tests/fixtures/identities/
tests/fixtures/identities_test.json
tests/fixtures/*.parquet

# Identity images are fetched by tools/fetch_identities.py from a DOI-stable
# source. Not redistributed from here: identities.json and LICENSES.md record
# exactly which FRLL records they are, so the set is reproducible without
# republishing photographs of research participants.
benchmark/identities/*.jpg
benchmark/.frll_cache/

# PuLID resolves its weights relative to the cwd (models/flux1-dev.safetensors,
# models/antelopev2/, models/pulid_flux_*.safetensors). tools/stage_pulid.py
# makes this a symlink to $WORK because the FLUX single-file weight alone is
# 23.8 GB and $HOME is a 100 GB quota.
/models

# Score tables copied off the cluster for the report's table generator. They are
# small and irreplaceable, so they are tracked deliberately -- but the parquets
# are binary and .gitattributes already marks them as such.
!results-backup/scores/*.parquet
# LaTeX build products. These were tracked, and because the cluster is where the
# report is compiled, every build left them modified there and made
# `git pull --ff-only` abort. The abort is easy to miss: git prints the error on
# stderr and "Updating <a>..<b>" on stdout, so a `2>&1 | tail -1` shows the
# reassuring line and the checkout silently stays behind. Rebuild with
# `bash tools/build_report.sh`.
report/report.pdf
report/report.aux
report/report.log
report/report.out
report/report.toc
# ... and those of the IDEA Lab template's chain (biber, makeglossaries-lite)
report/report.lof
report/report.lot
report/report.bbl
report/report.bcf
report/report.blg
report/report.run.xml
report/report.acn
report/report.acr
report/report.alg
report/report.glo
report/report.gls
report/report.glg
report/report.ist
report/report.glsdefs
report/biber.out
report/glossaries.out
report/report.idx
# The template's logos are part of the build, unlike every other PNG here.
!report/assets/*.png
# The template as the chair supplied it; report/ carries the copy in use.
IDEA_Lab_LATEX_Template__1_/

# Personal details for the title page (e-mail, matriculation number); local only
report/config/personal.tex
